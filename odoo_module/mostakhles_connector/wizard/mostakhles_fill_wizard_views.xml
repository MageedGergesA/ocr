<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_mostakhles_fill_wizard_form" model="ir.ui.view">
        <field name="name">mostakhles.fill.wizard.form</field>
        <field name="model">mostakhles.fill.wizard</field>
        <field name="arch" type="xml">
            <form string="استخرِج واملأ بمُستخلِص">
                <field name="state" invisible="1"/>
                <field name="res_model" invisible="1"/>
                <field name="res_id" invisible="1"/>
                <field name="hid" invisible="1"/>
                <div class="alert alert-info text-center py-1" role="status"
                     invisible="not usage_info">
                    <field name="usage_info" nolabel="1" readonly="1"/>
                </div>
                <group>
                    <field name="record_name" readonly="1"/>
                    <field name="document" filename="filename"
                           invisible="state != 'upload'" required="state == 'upload'"/>
                    <field name="filename" invisible="1"/>
                    <field name="hard" invisible="state != 'upload'"/>
                    <field name="document_type" invisible="not document_type" readonly="1"/>
                </group>
                <div invisible="state != 'preview'" class="text-muted">
                    <field name="info" readonly="1" nolabel="1"/>
                </div>
                <field name="line_ids" invisible="state != 'preview'">
                    <list editable="bottom" create="false" delete="false">
                        <field name="apply" widget="boolean_toggle"/>
                        <field name="target_label"/>
                        <field name="source_field" optional="hide"/>
                        <field name="value"/>
                        <field name="confidence"
                               decoration-danger="confidence &lt; 60"
                               decoration-warning="confidence &gt;= 60 and confidence &lt; 80"
                               decoration-success="confidence &gt;= 80"/>
                        <field name="target_field" column_invisible="1"/>
                    </list>
                </field>
                <footer>
                    <button name="action_extract" type="object" string="استخرج"
                            class="btn-primary" invisible="state != 'upload'" data-hotkey="q"/>
                    <button name="action_apply" type="object" string="طبّق على السجل"
                            class="btn-primary" invisible="state != 'preview'" data-hotkey="q"/>
                    <button string="إلغاء" special="cancel" class="btn-secondary" data-hotkey="x"/>
                </footer>
            </form>
        </field>
    </record>

</odoo>
