<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_mostakhles_mapping_list" model="ir.ui.view">
        <field name="name">mostakhles.mapping.list</field>
        <field name="model">mostakhles.mapping</field>
        <field name="arch" type="xml">
            <list string="تعيينات الحقول">
                <field name="name"/>
                <field name="model_name"/>
                <field name="document_type"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <record id="view_mostakhles_mapping_form" model="ir.ui.view">
        <field name="name">mostakhles.mapping.form</field>
        <field name="model">mostakhles.mapping</field>
        <field name="arch" type="xml">
            <form string="تعيين الحقول">
                <sheet>
                    <group>
                        <field name="name" placeholder="مثال: فاتورة مورّد"/>
                        <field name="model_id" options="{'no_create': True}"/>
                        <field name="model_name" invisible="1"/>
                        <field name="document_type"
                               placeholder="invoice / prescription / egyptian_id — أو اتركه فارغًا"/>
                        <field name="active" widget="boolean_toggle"/>
                        <field name="action_id" invisible="1"/>
                    </group>
                    <separator string="تعيين الحقول (حقل مُستخلِص ← حقل أودو)"/>
                    <field name="line_ids">
                        <list editable="bottom">
                            <field name="source_field" placeholder="patient_name"/>
                            <field name="field_id"
                                   domain="[('model_id', '=', parent.model_id)]"
                                   options="{'no_create': True}"/>
                        </list>
                    </field>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_mostakhles_mapping" model="ir.actions.act_window">
        <field name="name">تعيينات الحقول</field>
        <field name="res_model">mostakhles.mapping</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">أنشئ أول تعيين حقول</p>
            <p>اربط حقول المستندات المستخرَجة بحقول نماذج أودو، ثم استخدم زر
               «استخرِج واملأ بمُستخلِص» في قائمة إجراءات أي سجل.</p>
        </field>
    </record>

</odoo>
