# Copy to .env and fill in. Never commit the real .env.
# Every key here must be declared in backend/app/config.py:Settings.
# extra="forbid" means typos crash boot loudly — pay attention to names.

# ---- Required to boot ----
DATABASE_URL=postgresql://mostakhles:devpass@localhost:5432/mostakhles
GEMINI_API_KEY=

# ---- Environment ----
ENV=local
LOG_LEVEL=INFO
LOG_FORMAT=plain

# ---- LLM (Gemini) ----
# Uncomment to override; defaults live in app/config.py.
# GEMINI_MODEL_EASY=gemini-3.1-flash-lite
# GEMINI_MODEL_HARD=gemini-3.5-flash
GEMINI_TIMEOUT_MS=60000
MAX_DAILY_GEMINI_USD=50.0
EST_COST_PER_CREDIT_USD=0.0019

# ---- Plan / pricing ----
STRONG_UNITS=8
DEMO_MONTHLY_LIMIT=2000
DEMO_API_KEY=mk_demo_public

# ---- Sessions / cookies ----
SESSION_TTL_DAYS=30
COOKIE_SECURE=1

# ---- Admin ----
ADMIN_EMAILS=you@example.com

# ---- SMTP (transactional email) ----
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_SSL=0

# ---- Cloudflare Turnstile (anti-bot on signup) ----
CF_TURNSTILE_SECRET=
CF_TURNSTILE_SITEKEY=

# ---- Sentry ----
SENTRY_DSN=
SENTRY_TRACES_RATE=0.05
SENTRY_ENV=local

# ---- HTTP host / CORS ----
ALLOWED_HOSTS=localhost,127.0.0.1,mostakhles.ai,www.mostakhles.ai
ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# ---- File limits ----
MAX_UPLOAD_MB=20
MAX_PDF_PAGES=100
PDF_NATIVE_MAX_PAGES=5
MAX_JSON_BODY_KB=2048

# ---- Login rate limit ----
LOGIN_RATE_MAX=5
LOGIN_RATE_WINDOW_SEC=900

# ---- Payment providers (Paymob + PayPal — wired in Wave 10+) ----
PAYPAL_CLIENT_ID=
PAYPAL_SECRET=
PAYPAL_WEBHOOK_ID=
PAYPAL_MODE=sandbox
PAYMOB_API_KEY=
PAYMOB_HMAC=
PAYMOB_IFRAME_ID=
