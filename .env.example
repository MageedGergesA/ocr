# Copy to .env and fill in. Never commit the real .env.
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Model routing (cost control): Haiku for easy/printed docs, Sonnet for hard/handwritten
MODEL_EASY=claude-haiku-4-5-20251001
MODEL_HARD=claude-sonnet-4-6

# Database. SQLite locally; set to a postgresql:// URL in production.
DATABASE_URL=sqlite:///./mostakhles.db

# Public demo (the /app page) — fixed key + its monthly quota
DEMO_API_KEY=mk_demo_public
DEMO_MONTHLY_LIMIT=500
